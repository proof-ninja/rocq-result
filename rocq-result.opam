opam-version: "2.0"
synopsis: "A result type for Rocq"
description: """
A result type with Ok and Error constructors.
"""

maintainer: "Yoshihiro Imai <y.imai@proof-ninja.co.jp>"
authors: [
  "Yoshihiro Imai <y.imai@proof-ninja.co.jp>"
  "ymoymoon"
  ]

homepage: "https://proof-ninja.co.jp/"
bug-reports: "https://proof-ninja.co.jp/rocq-result/issues"
dev-repo: "git+https://proof-ninja.co.jp/rocq-result.git"

depends: [
  "rocq-core" {>= "9.1" & < "9.2"}
]
build: [
  ["./configure.sh"]
  [make "-j" jobs]
]
install: [
  [make "install" "COQLIBINSTALL=%{lib}%/coq/user-contrib"]
]
